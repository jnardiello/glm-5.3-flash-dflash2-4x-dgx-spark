entry.sh: RANK=0 WORLD_SIZE=4 MASTER_ADDR=<MGMT_IP_RANK0> MASTER_PORT=29521 LOCAL_RANK=0
entry.sh: (MASTER_PORT = launcher --master-port 29520 + 1, to avoid a stale vLLM rendez-vous)
NCCLBENCH nccl_version=(2, 29, 7) world=4
NCCLBENCH env NCCL_ALGO=Ring
NCCLBENCH env NCCL_PROTO=LL,LL128,Simple
NCCLBENCH env NCCL_MIN_NCHANNELS=4
NCCLBENCH env NCCL_MAX_NCHANNELS=4
NCCLBENCH env LD_PRELOAD=/opt/patched-nccl/libnccl.so.2

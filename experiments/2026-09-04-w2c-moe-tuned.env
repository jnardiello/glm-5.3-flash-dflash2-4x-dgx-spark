# W2c — Triton fused-MoE backend WITH a GB10-tuned kernel config.
# VERDICT 2026-09-04: PROMOTED as the hybrid file (commit 8bf22b2); the mount now lives in
# cluster.env, this overlay is kept as the record of the window and is redundant with
# production (the production confirmation, two clean passes, is in
# bench-results/2026-09-04-w2c-moe-tuned.md and docs/gate.md § Baseline — 2026-09-04).
# Same arm as W2a (--moe-backend triton, already production in cluster.env) plus the
# tuned config produced by node/moe-tune: W2a runs Triton on upstream's DEFAULT config,
# which has no entry for our shape (E=288, N=512, GB10); this window measures what the
# tuning is worth. Prefill is where the default hurts most (watch 30k/100k).
#
# DEPENDS ON: the merged JSON committed as
#   node/moe-configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json
# and pushed to ~/tp4/moe-configs/ by ./scripts/deploy.sh. Without it docker would create a
# DIRECTORY at the mount target and the rank would start with a broken configs dir, so the
# guard below aborts that rank first (the launcher runs under `set -e`; this file is sourced
# by it, so `exit 1` stops the rank before `docker run`).
#
# The guard only fires on a node: ENV_DIR is set by launch-glm53-tp4.sh and by nothing else
# (tp4ctl uses HERE, deploy.sh uses REPO), and both also source this file on the workstation,
# where the path legitimately does not exist. TP4_DRY_RUN=1 skips it too.
#
# The path is written as $HOME and SINGLE-quoted: the launcher expands a leading $HOME in
# every `-v` source of EXTRA_DOCKER_ENV on the node (expand_home() in launch-glm53-tp4.sh),
# so the value must survive unexpanded until then. Same convention as the other 2026-09-04
# overlays. The filename has commas, '=' and '[]' but NO spaces, so the word-splitting is
# safe, and the glob-looking `[128,128]` matches nothing on disk.
#
# Rollback: ./tp4ctl restart without TP4_ENV (~22 min); the JSON on the nodes is inert.
if [ -n "${ENV_DIR:-}" ] && [ "${TP4_DRY_RUN:-0}" != "1" ]; then
  [ -f "$HOME/tp4/moe-configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json" ] || {
    echo "ERROR: tuned MoE config missing on this node (run TP4_ENV=experiments/2026-09-04-w2c-moe-tuned.env ./scripts/deploy.sh after committing node/moe-configs/)" >&2
    exit 1
  }
fi
EXTRA_VLLM_ARGS="--kv-cache-memory=17179869184 --moe-backend triton"
EXTRA_DOCKER_ENV='-v $HOME/tp4/moe-configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/configs/E=288,N=512,device_name=NVIDIA_GB10,dtype=fp8_w8a8,block_shape=[128,128].json:ro'

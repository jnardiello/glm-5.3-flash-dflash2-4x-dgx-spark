# W1 — observe + re-baseline (2026-09-03).
# Delta overlay: sourced by tp4ctl, the launcher and scripts/deploy.sh AFTER cluster.env.
# The engine flags stay exactly the production ones (same CONTAINER, same MAX_MODEL_LEN,
# same SPEC_TOKENS): this window only turns on observability, so the numbers it produces
# are a re-baseline of the production lane, not a new lane.
#   - NCCL init/net/graph/tuning traces, one log file per host+pid under /cache
#     (~/vllm-cache on the node);
#   - the vLLM torch profiler output directory, inert until a profile is requested.
# Rollback: ./tp4ctl restart with no TP4_ENV. See experiments/README.md.
EXTRA_DOCKER_ENV="-e NCCL_DEBUG=INFO -e NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH,TUNING -e NCCL_DEBUG_FILE=/cache/nccl-%h-%p.log -e VLLM_TORCH_PROFILER_DIR=/cache/profiles"

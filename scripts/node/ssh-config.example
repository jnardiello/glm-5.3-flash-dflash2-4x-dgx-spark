# TEMPLATE for the workstation's ~/.ssh/config — pre-filled with DUMMY data.
#
# Every workstation-side script (tp4ctl, scripts/*.sh) reaches a node through the ssh
# ALIAS listed in NODES in cluster.env, never through an address. Copy the four stanzas
# below into ~/.ssh/config (or into a file included from it) and replace the aliases, the
# addresses and the login with your own; keep them in the SAME ORDER as NODES, which is
# rank order 0..3.
#
# THE ALIAS MUST EQUAL THE NODE'S `hostname -s`. scripts/deploy-host.sh and
# scripts/bootstrap-node.sh compare the two before installing anything under /etc, so that
# one node's fabric netplan can never be installed on another (IDENTITY-MISMATCH), and
# scripts/node/etc/<alias>/40-cx7.yaml is looked up by that same alias.
#
# HostName may be a management address (as here), a MagicDNS name
# (`<ALIAS_RANK0>.<TAILNET>.ts.net`) or anything else that resolves. BatchMode is what the
# scripts rely on: the key must be passphrase-less, or already loaded in the agent.
#
# A copy of this file with your real values is expected at scripts/node/ssh-config, which is
# gitignored; nothing reads it, it is a convenience record next to the other node assets.

Host gx10-a gx10-b gx10-c gx10-d
    User alice
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30

Host gx10-a
    HostName 192.0.2.11

Host gx10-b
    HostName 192.0.2.12

Host gx10-c
    HostName 192.0.2.13

Host gx10-d
    HostName 192.0.2.14

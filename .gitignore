# Housekeeping
.DS_Store
__pycache__/
*.pyc
.ruff_cache/
.claude/settings.local.json

# --- Site configuration: created by the user from public templates, never committed.
/cluster.env
# Per-node netplan directories (one per alias). The template and the shared/common
# material stay tracked.
scripts/node/etc/*/
!scripts/node/etc/common/
!scripts/node/etc/default/
scripts/node/etc/common/99-tp4-nopasswd
scripts/node/tp4-autostart.service
scripts/node/ssh-config
scripts/mirror-private-terms.txt
.claude/

# Internal experiment records and reports stay local and must never enter a public mirror.
/bench-results/
/reports/
/experiments/
/todo/

# Operator-only tools retained locally but excluded from the public repository.
/scripts/prof-capture.sh
/scripts/nccl-bench.sh
/scripts/node/moe-tune/
/scripts/node/nccl-bench/
/scripts/node/host/nsys-entry.sh

# Pinned versions consumed by scripts/bootstrap-node.sh.
#
# Every value below was read from the live cluster on 2026-09-04, read-only (the two
# single-node probes were run on rank 1):
#   KERNEL / KERNEL_PKGS  ssh <ALIAS_RANK1> "uname -r; dpkg -l | grep 6.17.0-1031 | awk '{print \$2}'"
#   DRIVER                ssh <ALIAS_RANK1> nvidia-smi --query-gpu=driver_version --format=csv,noheader
#   RDMA_CORE_MIN         dpkg-query -s rdma-core (all 4 nodes: 50.0-2ubuntu0.2)
#   OS_RELEASE            lsb_release -ds
#   DOCKER_MIN            docker version --format '{{.Server.Version}}'
#   NVIDIA_CTK_MIN        nvidia-ctk --version
#   CX7_FW                ibv_devinfo | grep fw_ver   (both ports of both HCAs)
#   TAILSCALE_MIN         tailscale version
#
# Not here on purpose:
#   IMAGE        part of the recipe, read from cluster.env at runtime (only its DIGEST is
#                pinned here, see IMAGE_DIGEST below).
#   NCCL sha256  node/nccl/SHA256SUMS is the single source for the patched libnccl.so.2;
#                node/nccl/install-nccl.sh and scripts/verify-node.sh read it from there.

# Content digest of the container image named by IMAGE in cluster.env: the tag is mutable,
# the digest is not, so this is what actually pins the serving stack. Measured read-only on
# rank 2 on 2026-09-04:
#   ssh <ALIAS_RANK2> "sudo -n docker image inspect --format '{{index .RepoDigests 0}}' <IMAGE>"
# scripts/verify-node.sh compares every node's RepoDigest with it: WARN when this key is
# empty (nothing pinned), FAIL on a mismatch (a node serving a different image). Re-measure
# and update it deliberately when the recipe moves to another image.
IMAGE_DIGEST="ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6"

# Kernel the cluster is pinned to (uname -r must match exactly).
KERNEL=6.17.0-1031-nvidia

# The version-locked kernel packages present on ALL four nodes. These are the ones
# `apt-mark hold` must cover (bootstrap-node.sh holds only the ones actually installed).
# The `linux-*-nvidia-hwe-24.04` meta packages are NEVER held: holding a meta freezes the
# whole HWE stack and makes `apt full-upgrade` unsolvable.
KERNEL_PKGS="linux-headers-6.17.0-1031-nvidia linux-image-6.17.0-1031-nvidia linux-modules-6.17.0-1031-nvidia linux-modules-nvidia-580-open-6.17.0-1031-nvidia linux-modules-nvidia-fs-6.17.0-1031-nvidia linux-nvidia-6.17-headers-6.17.0-1031"

# Version-locked kernel packages installed on some nodes only (ranks 2 and 3 carry the
# tools packages). They are held when installed and ignored when absent.
KERNEL_PKGS_EXTRA="linux-nvidia-6.17-tools-6.17.0-1031 linux-tools-6.17.0-1031-nvidia"

# NVIDIA driver the recipe was measured with (nvidia-smi --query-gpu=driver_version).
# The driver packages themselves (nvidia-driver-580-open, nvidia-kernel-common-580,
# nvidia-kernel-source-580-open, 580.173.02-0ubuntu0.24.04.1) are deliberately NOT held:
# the ABI that must not move is the kernel module set, and that is already frozen by the
# held `linux-modules-nvidia-580-open-6.17.0-1031-nvidia`. Holding the userspace driver
# instead would block security updates while still allowing a module/driver mismatch.
# bootstrap-node.sh therefore reports a driver difference as FAIL (drift, operator decision)
# rather than pinning it with apt.
DRIVER=580.173.02

# Minimum rdma-core / ibverbs-utils major version (nodes run 50.0-2ubuntu0.2).
RDMA_CORE_MIN=50

# OS release the recipe was measured on (`lsb_release -ds`, exact match).
# scripts/verify-node.sh reports a different release as FAIL: the kernel pin above only makes
# sense inside this release's HWE stack.
OS_RELEASE="Ubuntu 24.04.4 LTS"

# Docker engine: MINIMUM server version, compared numerically (29.2.1 is what the nodes run).
# A newer engine is fine — only an older one is a FAIL, because the `--gpus all` path and the
# DOCKER-USER chain the fabric rules live in are what matter, not the exact build.
DOCKER_MIN="29.2.1"

# NVIDIA Container Toolkit: MINIMUM version, compared numerically (nodes run 1.20.0).
NVIDIA_CTK_MIN="1.20.0"

# ConnectX-7 firmware, as measured on the shipped nodes (`ibv_devinfo` fw_ver, both ports).
# A different firmware is a WARN, not a FAIL: it is the vendor image the GX10 shipped with, this
# repo never flashes an HCA, and the fabric checks that actually gate the recipe are the port
# state and MTU/speed rows. WARN so a silent firmware drift is still visible in the table.
CX7_FW="28.45.4028"

# Tailscale: MINIMUM version, WARN only. Tailscale is the access path to the nodes, not a
# dependency of the fabric or of the serving stack — the cluster runs identically without it.
TAILSCALE_MIN="1.102.3"

# Weight revisions. `hf download` leaves no git checkout on the node, so `git rev-parse HEAD`
# does not apply: the commit that was fetched is recorded by the downloader itself, in the
# FIRST line of <dir>/.cache/huggingface/download/config.json.metadata on the node that ran
# the download (line 2 is the file's etag, line 3 a timestamp). Both values below were read
# there, read-only, on rank 0 on 2026-09-04 — they are the checkpoints this recipe was
# measured on:
#   ssh <ALIAS_RANK0> "head -1 <MODEL_DIR>/.cache/huggingface/download/config.json.metadata"
#   ssh <ALIAS_RANK0> "head -1 <DRAFT_DIR>/.cache/huggingface/download/config.json.metadata"
#   MODEL_REV  zai-org/GLM-5.3-Flash, also read from cluster.env by
#              scripts/fetch-fp8-weights.sh, which passes it to `hf download --revision` and
#              writes it into the .glm53-fp8-synced fan-out marker. The `:-` form below is
#              deliberate: cluster.env is sourced BEFORE this file by verify-node.sh and
#              bootstrap-node.sh, so a value pinned there always wins.
#   DRAFT_REV  incoai/GLM-5.3-Flash-DFlash2. No fetch script consumes it (docs/weights.md § 3
#              downloads the drafter with a plain `hf download`): verify-node.sh compares it
#              with the drafter's own metadata on the node that downloaded it.
# The `.cache/` directory is NOT fanned out (the rsync excludes it), so only the head carries
# the metadata; on the other ranks the identity of the weights is the .glm53-fp8-synced marker
# plus the fingerprint verify-node.sh prints (sha256 of config.json and the shard count).
MODEL_REV="${MODEL_REV:-03eb5366286afd40d2221b1d9c63a6dd1ba4832e}"
DRAFT_REV="${DRAFT_REV:-bf582e4eacc1810f76656d1811693ff6c6737d2a}"
